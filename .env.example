# Backblaze B2 (required) — S3-compatible API
# Create an application key + bucket at:
#   https://secure.backblaze.com/app_keys.htm
B2_APPLICATION_KEY_ID=your_application_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
# Region slug, e.g. us-west-004 / us-east-005 / eu-central-003. The S3 endpoint
# is derived from this (https://s3.<region>.backblazeb2.com) — no hardcoded host.
B2_REGION=us-west-004
# Optional: public / CDN base URL for building browser links to public objects.
# Leave blank unless your bucket is public or fronted by a CDN.
B2_PUBLIC_URL_BASE=

# Example of what filled-in values look like (fake — for visual reference only):
# B2_APPLICATION_KEY_ID=000000000000abc0000000001
# B2_APPLICATION_KEY=your-secret-application-key
# B2_BUCKET_NAME=my-video-library
# B2_REGION=us-west-004
